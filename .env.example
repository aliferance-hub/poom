# POOM — safe configuration template (copy to .env and adapt; NEVER commit .env)
# Portable local PostgreSQL (dev only — no external/production credentials).
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/poom"

# Mock payment gateway for development (real gateway = separate adapter, later phase).
MOCK_PAYMENTS="1"

# P2-D demo-role login phones (DEMO placeholders — clearly non-production).
# A real credential provider replaces these in the auth milestone.
SELLER_LOGIN="09012345678"
ADMIN_LOGIN="09000000000"
